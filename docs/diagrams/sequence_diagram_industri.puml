@startuml
actor "Industri (Pabrik)" as Pabrik
boundary "Halaman Bulk Order" as UI
database "Sistem Backend" as BE

Pabrik -> UI : Buka Menu "Stok Gudang"
UI --> Pabrik : Tampilkan Grafik Stok (Live)

Pabrik -> UI : Klik "Beli Stok" (Input 1000 Liter)
UI -> BE : Cek Ketersediaan Stok (GET)
activate BE
BE --> UI : Stok Tersedia (Harga: Rp 8.000.000)
deactivate BE

Pabrik -> UI : Upload Bukti Bayar
Pabrik -> UI : Klik "Konfirmasi Pesanan"

activate UI
    UI -> BE : Kirim Data Order & Bukti (POST)
    activate BE
    
    ' Proses Backend Lurus (Tanpa Error Handling)
    BE -> BE : Validasi Bukti Bayar
    BE -> BE : Buat Record "PesananBulk"
    BE -> BE : Kurangi Stok Global (-1000L)
    BE -> BE : Set Status "Lunas/Shipping"
    
    BE --> UI : Return Data Invoice
    deactivate BE
    
    UI --> Pabrik : Tampilkan "Pembelian Berhasil"
deactivate UI
@enduml