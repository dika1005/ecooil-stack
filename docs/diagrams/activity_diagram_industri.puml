@startuml
title Activity Diagram - Industri (Pembelian Bulk)

|Industri (Pabrik)|
start
:Login ke Sistem;
:Masuk ke Dashboard Industri;
:Melihat Grafik Stok Gudang Virtual;

if (Stok Cukup?) then (Tidak)
    :Tunggu Stok Bertambah;
    stop
else (Ya)
    :Klik "Buat Pesanan Bulk (PO)";
    :Input Jumlah Tonase (Misal: 1 Ton);
    :Klik "Checkout";

    |Sistem|
    :Cek Ketersediaan Stok Global;
    :Hitung Total Tagihan (Tonase x Harga Jual);
    :Generate Invoice Digital;
    :Tampilkan Halaman Pembayaran;

    |Industri (Pabrik)|
    :Lakukan Transfer Bank;
    :Upload Bukti Transfer;
    :Klik "Konfirmasi Bayar";

    |Sistem|
    :Verifikasi Pembayaran (Oleh Admin/Sistem);
    
    if (Valid?) then (Tidak / Bukti Palsu)
        :Tolak Pembayaran;
        :Kirim Notifikasi Gagal;
        detach
    else (Ya / Valid)
        :Update Status Order (Lunas/Dikirim);
        :Kurangi Stok Gudang Virtual;
        :Kirim Invoice Lunas & Surat Jalan;
        
        ' Transisi langsung ke Industri agar garis tidak putus
        |Industri (Pabrik)|
        :Terima Notifikasi "Sedang Dikirim";
        :Download Invoice Lunas;
        stop
    endif
endif

@enduml