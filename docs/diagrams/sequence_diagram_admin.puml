@startuml
actor "Admin Sistem" as Admin
boundary "Halaman Admin" as UI
database "Sistem Backend" as BE

Admin -> UI : Buka Menu "Withdrawal Request"
UI -> BE : Ambil Daftar Request Pending (GET)
activate BE
BE --> UI : Return Daftar Request
deactivate BE

UI --> Admin : Tampilkan Daftar Request

Admin -> UI : Pilih Request & Upload Bukti Transfer
Admin -> UI : Klik "Approve"

activate UI
    UI -> BE : Kirim Approval (PUT)
    activate BE
    
    ' Proses Backend Lurus (Tanpa Error Handling)
    BE -> BE : Validasi Request
    BE -> BE : Update Status (Selesai)
    BE -> BE : Catat Log Transaksi
    
    BE --> UI : Konfirmasi Sukses
    deactivate BE
    
    UI --> Admin : Tampilkan "Withdrawal Berhasil Diproses"
deactivate UI
@enduml
