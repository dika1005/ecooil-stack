# ========================================
# EcoOil Stack - Environment Variables
# ========================================

# ----------------------------------------
# Database Configuration
# ----------------------------------------
DATABASE_URL="db://username:password@localhost/dbname"
DATABASE_USER="username"
DATABASE_PASSWORD="password"
DATABASE_NAME="dbname"
DATABASE_HOST="localhost"
DATABASE_PORT=yourport

# Docker Compose DB settings
DB_ROOT_PASSWORD=password
DB_NAME=dbname
DB_USER=username
DB_PASSWORD=passwiord
DB_PORT=port

# ----------------------------------------
# JWT Configuration
# ----------------------------------------
JWT_SECRET=ecooil-secret-key-minimum-32-characters
JWT_ACCESS_SECRET=ecooil-access-token-secret
JWT_REFRESH_SECRET=ecooil-refresh-token-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=20m

# ----------------------------------------
# API Configuration
# ----------------------------------------
API_PORT=portapi
NODE_ENV=dev

# ----------------------------------------
# Web Configuration
# ----------------------------------------
WEB_PORT=port
VITE_API_URL=apiurl

# ----------------------------------------
# phpMyAdmin (development only)
# ----------------------------------------
PHPMYADMIN_PORT=portphpmyadmin
